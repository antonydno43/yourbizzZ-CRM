# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend Email Configuration
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourbizz.com
RESEND_REPLY_TO=support@yourbizz.com

# Application Configuration
NEXT_PUBLIC_APP_NAME=YourBizz
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DESCRIPTION=YourBizz SaaS CRM - Drag & Drop Website Builder

# Authentication
NEXT_PUBLIC_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Database
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/yourbizz

# GitHub (for deployment)
GITHUB_TOKEN=your-github-token

# Vercel
VERCEL_URL=http://localhost:3000
VERCEL_ENVIRONMENT=development

# Custom SMTP (if not using Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=YourBizz

# Security
NEXTAUTH_SECRET=your-super-secret-key-for-nextauth
NEXTAUTH_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/*,application/pdf

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
